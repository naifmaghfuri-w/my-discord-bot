{
  "name": "discord-bot",
  "version": "1.1.0",
  "private": true,
  "description": "Professional Discord bot built with TypeScript, discord.js v14 and MongoDB",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy": "tsx src/deploy-commands.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.17.3",
    "dotenv": "^16.4.5",
    "mongoose": "^8.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
